<UserControl x:Class="CraftDeck.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <Border Style="{StaticResource H1Bar}"/>
            <TextBlock Text="Account, Java, memory and launch options. Changes are saved and applied automatically." Style="{StaticResource Subtle}" Margin="0,7,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardIcon}"><TextBlock Style="{StaticResource Icon}" Text="&#xE790;"/></Border>
                            <TextBlock Text="Appearance" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource Subtle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <RadioButton x:Name="ThemeDark" Style="{StaticResource SegButton}" Content="Dark"
                                         GroupName="theme" Margin="0,0,8,0" Checked="ThemeMode_Checked"/>
                            <RadioButton x:Name="ThemeLight" Style="{StaticResource SegButton}" Content="Light"
                                         GroupName="theme" Checked="ThemeMode_Checked"/>
                        </StackPanel>

                        <TextBlock Text="Animated background" Style="{StaticResource Subtle}" Margin="0,16,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <RadioButton x:Name="FxOff" Style="{StaticResource SegButton}" Content="Off"
                                         GroupName="fx" Margin="0,0,8,0" Checked="FxMode_Checked"/>
                            <RadioButton x:Name="FxTriangles" Style="{StaticResource SegButton}" Content="Triangles"
                                         GroupName="fx" Margin="0,0,8,0" Checked="FxMode_Checked"/>
                            <RadioButton x:Name="FxSnow" Style="{StaticResource SegButton}" Content="Snow"
                                         GroupName="fx" Checked="FxMode_Checked"/>
                        </StackPanel>
                        <TextBlock Text="Triangles: drifting dots link up and lean away from your cursor. Snow: three layers of flakes come down through a gust that builds and dies — the near ones soft and fast, the far ones a haze of pinpoints."
                                   Style="{StaticResource Subtle}" FontSize="11" Margin="0,8,0,0" Opacity="0.75"/>

                        <TextBlock Text="Effect color" Style="{StaticResource Subtle}" Margin="0,14,0,0"/>
                        <WrapPanel x:Name="FxPalette" Margin="0,10,0,0" MaxWidth="300" HorizontalAlignment="Left"/>

                        <TextBlock Text="Background preset" Style="{StaticResource Subtle}" Margin="0,16,0,0"/>
                        <WrapPanel x:Name="BackgroundPalette" Margin="0,9,0,0" MaxWidth="420" HorizontalAlignment="Left"/>

                        <TextBlock Text="Then pick how it fills the backdrop" Style="{StaticResource Subtle}" Margin="0,16,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <RadioButton x:Name="BgStatic" Style="{StaticResource SegButton}" Content="Static colors"
                                         GroupName="bgstyle" Margin="0,0,8,0" Checked="BgStyle_Checked"/>
                            <RadioButton x:Name="BgGradient" Style="{StaticResource SegButton}" Content="Gradient"
                                         GroupName="bgstyle" Checked="BgStyle_Checked"/>
                        </StackPanel>
                        <TextBlock Text="Each preset retints the whole window — backdrop, sidebar, cards and text."
                                   Style="{StaticResource Subtle}" FontSize="11" Margin="0,8,0,0" Opacity="0.75"/>

                        <TextBlock Text="Accent color" Style="{StaticResource Subtle}" Margin="0,16,0,0"/>
                        <WrapPanel x:Name="AccentPalette" Margin="0,10,0,0" MaxWidth="300" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardIcon}"><TextBlock Style="{StaticResource Icon}" Text="&#xE950;"/></Border>
                            <TextBlock Text="Java" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="JavaDetected" Style="{StaticResource Subtle}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="JavaBox" ToolTip="Full path to javaw.exe — empty = auto-detect per game version"/>
                            <Button Grid.Column="1" Style="{StaticResource Outlined}" Margin="6,0,0,0" Click="JavaBrowse_Click" AutomationProperties.Name="Browse" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE838;"/>
                                    <TextBlock Text="Browse"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource Ghost}" Margin="6,0,0,0" Click="JavaAuto_Click" AutomationProperties.Name="Auto" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE794;"/>
                                    <TextBlock Text="Auto"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="Old versions (≤1.16) use Java 8; 1.17–1.17.1 use Java 16; 1.18–1.20 use Java 17; 1.20.5+ use Java 21. The best matching runtime is picked automatically."
                                   Style="{StaticResource Subtle}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardIcon}"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;"/></Border>
                            <TextBlock Text="Performance" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Min memory (MB)" Style="{StaticResource Subtle}"/>
                                <TextBox x:Name="MinMemBox" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max memory (MB)" Style="{StaticResource Subtle}"/>
                                <TextBox x:Name="MaxMemBox" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Extra JVM arguments" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                        <TextBox x:Name="JvmBox" Margin="0,4,0,0"/>
                        <TextBlock Text="Extra game arguments" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                        <TextBox x:Name="GameBox" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardIcon}"><TextBlock Style="{StaticResource Icon}" Text="&#xEA86;"/></Border>
                            <TextBlock Text="Launcher" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="RootDirText" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="CloseOnLaunch" Content="Close launcher when the game starts" Margin="0,10,0,0"/>
                        <Border x:Name="SavedText" Visibility="Collapsed" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Background="{DynamicResource Bg2Brush}" CornerRadius="8" Padding="10,5"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BtnIcon}" FontSize="12" Text="&#xE73E;"/>
                                <TextBlock Text="Saved automatically" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
