<UserControl x:Class="CraftDeck.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CraftDeck.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ContentCard">
            <Border Style="{StaticResource HoverCard}" Padding="12" Margin="0,0,0,8"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="12" VerticalAlignment="Top"
                            Background="{DynamicResource TileGradBrush}"
                            BorderBrush="{DynamicResource HairlineDarkBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="{Binding Letter}" FontSize="22" FontWeight="Bold"
                                       Visibility="{Binding LetterVis}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Icon}" Width="52" Height="52" Visibility="{Binding IconVis}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Subtle}" FontSize="12"
                                   Visibility="{Binding DescVis}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding MetaVis}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Ghost}" Padding="10,6" Margin="0,0,4,0" Click="Versions_Click"
                                Tag="{Binding}" Visibility="{Binding SwitchVis}" ToolTip="Change version"
                                AutomationProperties.Name="Versions">
                            <ctl:Icon Style="{StaticResource BtnIcon}" Margin="0" Glyph="ChevronDown" Size="16" Weight="2.4"/>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Padding="10,6" Click="Delete_Click" Tag="{Binding}"
                                ToolTip="Delete" AutomationProperties.Name="Delete">
                            <ctl:Icon Style="{StaticResource BtnIcon}" Margin="0" Glyph="Trash" Size="15"
                                      Foreground="{DynamicResource DangerBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="← Back" Style="{StaticResource Ghost}" Click="Back_Click" Margin="-10,0,8,0"/>
            <TextBlock x:Name="Title" Style="{StaticResource H1}" FontSize="22"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBox" Width="44" Height="44" CornerRadius="11" Margin="0,0,12,0"
                        VerticalAlignment="Center" Background="{DynamicResource TileGradBrush}"
                        BorderBrush="{DynamicResource HairlineDarkBrush}" BorderThickness="1">
                    <Grid>
                        <Path x:Name="IconStar" Data="{StaticResource Spark}" Width="22" Height="22"
                              Stretch="Uniform" Opacity="0.5" Fill="{DynamicResource TextBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="IconGlyph" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="IconImage" Width="40" Height="40" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SubInfo" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DirInfo" Style="{StaticResource Subtle}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Ghost}" Click="Settings_Click" Margin="0,0,8,0"
                        ToolTip="Instance settings" AutomationProperties.Name="Instance settings">
                    <ctl:Icon Style="{StaticResource BtnIcon}" Margin="0" Glyph="Sliders" Size="16"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource Outlined}" Click="Add_Click" Margin="0,0,8,0"
                        AutomationProperties.Name="Add content">
                    <StackPanel Orientation="Horizontal">
                        <ctl:Icon Style="{StaticResource BtnIcon}" Glyph="Plus"/>
                        <TextBlock Text="Add content"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" x:Name="PlayBtn" Style="{StaticResource Accent}" MinWidth="120" Click="Play_Click"
                        AutomationProperties.Name="Play">
                    <StackPanel Orientation="Horizontal">
                        <ctl:Icon x:Name="PlayGlyph" Style="{StaticResource BtnIcon}" Glyph="Play"/>
                        <ctl:Icon x:Name="StopBox" Style="{StaticResource BtnIcon}" Glyph="Stop" Size="13" Visibility="Collapsed"/>
                        <TextBlock x:Name="PlayText" Text="Play"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <TabItem Header="Mods">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,0,0">
                                <ItemsControl x:Name="ModsList" ItemTemplate="{StaticResource ContentCard}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ProgressBar x:Name="ModsBusy" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Shaders">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,0,0">
                                <ItemsControl x:Name="ShadersList" ItemTemplate="{StaticResource ContentCard}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ProgressBar x:Name="ShadersBusy" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Resource packs">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,0,0">
                                <ItemsControl x:Name="RpsList" ItemTemplate="{StaticResource ContentCard}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ProgressBar x:Name="RpsBusy" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Worlds">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,0,0">
                                <ItemsControl x:Name="WorldsList" ItemTemplate="{StaticResource ContentCard}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ProgressBar x:Name="WorldsBusy" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Log">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LogState" Style="{StaticResource Subtle}" FontSize="11"/>
                        <TextBox Grid.Row="1" x:Name="LogBox" Margin="0,8,0,0" IsReadOnly="True"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Tag="No output yet — press Play and the game log shows up here."
                                 AutomationProperties.Name="Game log"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Save &amp; configs">
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8">
                        <StackPanel>
                            <Button Content="Open game folder" Style="{StaticResource Outlined}" HorizontalAlignment="Left" Click="OpenGame_Click"/>
                            <Button Content="Open world saves" Style="{StaticResource Outlined}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OpenSaves_Click"/>
                            <Button Content="Open config folder" Style="{StaticResource Outlined}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OpenConfig_Click"/>
                        </StackPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Multiplayer">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,24,0" MaxWidth="680" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Multiplayer" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="NetState" Style="{StaticResource Subtle}" FontSize="11.5"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>

                                    <Grid x:Name="NetStart" Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CodeBox" Tag="Paste a friend's code"
                                                 KeyDown="CodeBox_KeyDown" AutomationProperties.Name="Friend code"/>
                                        <Button x:Name="JoinBtn" Grid.Column="1" Style="{StaticResource Accent}"
                                                Margin="8,0,0,0" Padding="12,6" Click="Join_Click"
                                                AutomationProperties.Name="Join with code">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:Icon Style="{StaticResource BtnIcon}" Glyph="Play"/>
                                                <TextBlock Text="Join"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CreateBtn" Grid.Column="2" Style="{StaticResource Outlined}"
                                                Margin="8,0,0,0" Padding="12,6" Click="Create_Click"
                                                AutomationProperties.Name="Create game">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:Icon Style="{StaticResource BtnIcon}" Glyph="Plus"/>
                                                <TextBlock Text="New game"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid x:Name="NetLive" Margin="0,11,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource Bg2Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,9">
                                            <TextBlock x:Name="CodeText" FontFamily="Consolas, Cascadia Mono, monospace"
                                                       FontSize="14.5" TextWrapping="Wrap"
                                                       AutomationProperties.Name="Multiplayer code"/>
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource Ghost}" Padding="9,6"
                                                Margin="8,0,0,0" Click="CopyCode_Click" ToolTip="Copy code"
                                                AutomationProperties.Name="Copy multiplayer code">
                                            <ctl:Icon Style="{StaticResource BtnIcon}" Margin="0" Glyph="Copy" Size="14"/>
                                        </Button>
                                        <Button x:Name="LeaveBtn" Grid.Column="2" Style="{StaticResource Outlined}"
                                                Padding="12,6" Margin="8,0,0,0" Click="Leave_Click"
                                                AutomationProperties.Name="Leave game">
                                            <TextBlock Text="Leave"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Your world" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="ShareName" FontSize="13" TextWrapping="Wrap"
                                               Margin="0,5,0,0" Visibility="Collapsed"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="ShareState" Style="{StaticResource Subtle}" FontSize="11.5"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ShareBtn" Style="{StaticResource Outlined}" Padding="12,6"
                                                HorizontalAlignment="Left" Click="Share_Click"
                                                AutomationProperties.Name="Share this world">
                                            <TextBlock Text="Share this world"/>
                                        </Button>
                                        <ComboBox x:Name="PortPick" Grid.Column="1" Style="{StaticResource ChipCombo}"
                                                  Width="96" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  Visibility="Collapsed" SelectionChanged="PortPick_SelectionChanged"
                                                  AutomationProperties.Name="World port"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Worlds to join" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="RoomState" Style="{StaticResource Subtle}" FontSize="11.5"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="WorldList" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Subtle}"
                                                                   FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource Accent}"
                                                            Padding="12,6" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" Tag="{Binding}"
                                                            Click="Connect_Click" Visibility="{Binding Join}"
                                                            AutomationProperties.Name="Connect to this world">
                                                        <TextBlock Text="Connect"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Subtle}" FontSize="11" Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="Nothing to install or register on the other side: your friend only pastes this code. Both packs need the same Minecraft version and the same mods. If one of you is behind a strict router or a carrier-grade NAT, the two computers may not reach each other directly."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBox x:Name="FilterBox" Width="280" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-4,0,0" Visibility="Collapsed" TextChanged="Filter_TextChanged" Tag="Search mods…"
                     AutomationProperties.Name="Search in this pack"/>
        </Grid>

        <Popup x:Name="VersionPopup" Grid.Row="2" Placement="Bottom" PlacementTarget="{x:Null}"
               HorizontalOffset="-266" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="5" Width="300">
                <Grid MaxHeight="320">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="VersionTitle" Text="Version" Style="{StaticResource Subtle}"
                               FontSize="11" Margin="9,6,9,6"/>
                    <TextBlock x:Name="VersionBusy" Grid.Row="1" Text="Loading…" Style="{StaticResource Subtle}"
                               FontSize="12" Margin="9,0,9,8" Visibility="Collapsed"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="VersionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Ghost}" HorizontalContentAlignment="Left"
                                            Padding="9,6" Click="VersionRow_Click" Tag="{Binding}"
                                            AutomationProperties.Name="{Binding Label}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="12.5" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Subtle}" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <ctl:Icon Grid.Column="1" Glyph="Check" Size="13" Weight="2.2"
                                                      Visibility="{Binding CheckVis}" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
