<UserControl x:Class="CraftDeck.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CraftDeck.Controls">
    <Grid Margin="24,20" MaxWidth="1080" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Discover" Style="{StaticResource H1}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Install into:" Style="{StaticResource Subtle}" Margin="0,0,0,3"/>
                <ComboBox x:Name="TargetInstance" Height="32">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" KeyDown="Search_KeyDown" TextChanged="Search_TextChanged"/>
            <ComboBox Grid.Column="1" x:Name="SourceBox" Width="140" Margin="8,0,0,0" SelectionChanged="Type_Changed">
                <ComboBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FF1FDB62" VerticalAlignment="Center"/>
                        <TextBlock Text="Modrinth" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FFF1642E" VerticalAlignment="Center"/>
                        <TextBlock Text="CurseForge" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="TypeBox" Width="150" Margin="8,0,0,0" SelectionChanged="Type_Changed"/>
        </Grid>

        <StackPanel Grid.Row="2" x:Name="ResultBar" Orientation="Horizontal" Visibility="Collapsed"
                    Margin="0,0,0,10" HorizontalAlignment="Left">
            <Border Background="{DynamicResource AccentDimBrush}" CornerRadius="7"
                    Padding="8,3" VerticalAlignment="Center">
                <TextBlock x:Name="ResultType" FontSize="11.5" Text="Mods"
                           Foreground="{DynamicResource AccentFgBrush}"/>
            </Border>
            <ComboBox x:Name="VerPick" Style="{StaticResource ChipCombo}" Width="86" Margin="6,0,0,0"
                      VerticalAlignment="Center" Visibility="Collapsed"
                      AutomationProperties.Name="Minecraft version"/>
            <ComboBox x:Name="LoaderPick" Style="{StaticResource ChipCombo}" Width="98" Margin="6,0,0,0"
                      VerticalAlignment="Center" Visibility="Collapsed"
                      AutomationProperties.Name="Mod loader"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <TextBlock x:Name="Hint" Text="Loading…" Style="{StaticResource Subtle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/>
            <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                          ScrollChanged="Results_ScrollChanged">
                <ItemsControl x:Name="Results">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCard}" Padding="12" Margin="0,0,0,8"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="12" VerticalAlignment="Top"
                                            Background="{DynamicResource TileGradBrush}"
                                            BorderBrush="{DynamicResource HairlineDarkBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Letter}" FontSize="22" FontWeight="Bold"
                                                       Visibility="{Binding LetterVis}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Icon}" Width="52" Height="52"
                                                   Visibility="{Binding IconVis}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                            <TextBlock Text="{Binding Author}" Style="{StaticResource Subtle}" FontSize="12"
                                                       VerticalAlignment="Bottom" Margin="8,0,0,1"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Subtle}" FontSize="12"
                                                   MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,4"
                                                    Visibility="{Binding PinnedVis}">
                                                <TextBlock Text="{Binding PinnedLabel}" FontSize="11" Style="{StaticResource Subtle}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                            </Border>
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,3"
                                                    Visibility="{Binding LoaderVis}" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding Loader}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentFgBrush}"/>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Cats}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,4">
                                                            <TextBlock Text="{Binding}" FontSize="11" Style="{StaticResource Subtle}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border x:Name="Split" Style="{StaticResource SplitAccent}" HorizontalAlignment="Right">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="InstallBtn" Grid.Column="0" Style="{StaticResource Segment}"
                                                        Click="Install_Click" Tag="{Binding}"
                                                        ToolTip="{Binding ActionTip}" AutomationProperties.Name="{Binding ActionLabel}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="InstallSpinner" Style="{StaticResource Spinner}"
                                                                 Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                                        </Ellipse>
                                                        <ctl:Icon x:Name="InstallGlyph" Style="{StaticResource BtnIcon}" Glyph="Download"/>
                                                        <TextBlock Text="{Binding ActionLabel}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Border x:Name="Seam" Grid.Column="1" Width="1" Margin="0,5"
                                                        Background="{StaticResource AccentSeamBrush}"/>
                                                <Button x:Name="VersionBtn" Grid.Column="2" Style="{StaticResource Segment}"
                                                        Width="28" Padding="0" Click="Versions_Click" Tag="{Binding}"
                                                        ToolTip="Which version to install" AutomationProperties.Name="Versions">
                                                    <ctl:Icon Glyph="ChevronDown" Size="12" Weight="2.2"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                <ctl:Icon Style="{StaticResource StatIcon}" Glyph="Download"/>
                                                <TextBlock Style="{StaticResource Stat}" Text="{Binding Downloads}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:Icon Style="{StaticResource StatIcon}" Glyph="Heart"/>
                                                <TextBlock Style="{StaticResource Stat}" Text="{Binding Follows}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                            <ctl:Icon Style="{StaticResource StatIcon}" Glyph="Clock"/>
                                            <TextBlock Style="{StaticResource Stat}" Text="{Binding Updated}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Installing}" Value="True">
                                    <Setter TargetName="InstallSpinner" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="InstallGlyph" Property="Visibility" Value="Collapsed"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="installSpin">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="InstallSpinner"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.85" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="installSpin"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Installed}" Value="True">
                                    <Setter TargetName="Split" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="Split" Property="Effect" Value="{x:Null}"/>
                                    <Setter TargetName="Split" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter TargetName="Split" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="Seam" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                    <Setter TargetName="InstallBtn" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter TargetName="VersionBtn" Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                                    <Setter TargetName="InstallGlyph" Property="Glyph" Value="Check"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="4" x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Center"
                    Visibility="Collapsed" Margin="0,4,0,0">
            <Button x:Name="PrevBtn" Style="{StaticResource Outlined}" Padding="12,7" Click="PrevPage_Click">
                <StackPanel Orientation="Horizontal">
                    <ctl:Icon Glyph="ChevronLeft" Size="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Prev" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="PageLabel" Style="{StaticResource Subtle}" FontSize="12.5"
                       VerticalAlignment="Center" Margin="16,0"/>
            <Button x:Name="NextBtn" Style="{StaticResource Outlined}" Padding="12,7" Click="NextPage_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Next" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ctl:Icon Glyph="ChevronRight" Size="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Popup x:Name="VersionPopup" Grid.Row="3" Placement="Bottom" PlacementTarget="{x:Null}"
               HorizontalOffset="-232" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="5" Width="300">
                <Grid MaxHeight="320">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="VersionTitle" Text="Version" Style="{StaticResource Subtle}"
                               FontSize="11" Margin="9,6,9,6"/>
                    <TextBlock x:Name="VersionBusy" Grid.Row="1" Text="Loading…" Style="{StaticResource Subtle}"
                               FontSize="12" Margin="9,0,9,8" Visibility="Collapsed"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="VersionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Ghost}" HorizontalContentAlignment="Left"
                                            Padding="9,6" Click="VersionRow_Click" Tag="{Binding}"
                                            AutomationProperties.Name="{Binding Label}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="12.5" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Subtle}" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <ctl:Icon Grid.Column="1" Glyph="Check" Size="13" Weight="2.2"
                                                      Visibility="{Binding CheckVis}" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
