<UserControl x:Class="CraftDeck.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Accounts" Style="{StaticResource H1}"/>
            <Button Grid.Column="1" x:Name="AddBtn" Style="{StaticResource Outlined}" VerticalAlignment="Center"
                    Click="Add_Click" AutomationProperties.Name="Add account">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE710;"/>
                    <TextBlock Text="Add account"/>
                </StackPanel>
            </Button>
            <Border Grid.Column="1" x:Name="FlyAnchor" Width="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <ItemsControl x:Name="AccountsList" MaxWidth="640" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverSlide}" Width="440" Height="72" Padding="14"
                                Margin="0,0,0,10" MouseUp="Card_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="44" Height="44">
                                    <Ellipse Fill="{Binding AvatarBrush}"/>
                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="6" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TypeBadge}" FontSize="10.5" Style="{StaticResource Subtle}"/>
                                        </Border>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="7,2" Margin="6,0,0,0"
                                                Visibility="{Binding ActiveBadge}">
                                            <TextBlock Text="active" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentFgBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Danger}" Padding="10,5" FontSize="12"
                                        BorderThickness="0" VerticalAlignment="Center" Tag="{Binding Id}"
                                        Click="Remove_Click" AutomationProperties.Name="Remove">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE74D;"/>
                                        <TextBlock Text="Remove"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Popup x:Name="AddPopup" Grid.Row="0" PlacementTarget="{Binding ElementName=FlyAnchor}" Placement="Bottom"
               HorizontalOffset="-342" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{StaticResource Card}" Width="330" Margin="0,0,12,12" KeyDown="Popup_KeyDown">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <Button x:Name="MsTile" Style="{StaticResource Tile}" Margin="0,0,8,0"
                                Click="AddMicrosoft_Click" AutomationProperties.Name="Add Microsoft account">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xECA5;"/>
                                </Border>
                                <TextBlock Text="Microsoft" FontSize="13.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="OfflineTile_Click"
                                AutomationProperties.Name="Add offline account">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;"/>
                                </Border>
                                <TextBlock Text="Offline" FontSize="13.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <Grid x:Name="MsCodeRow" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MsCodeText" VerticalAlignment="Center" FontFamily="Consolas"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" x:Name="CopyCodeBtn" Style="{StaticResource Outlined}"
                                Click="CopyCode_Click" AutomationProperties.Name="Copy sign-in code">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE8C8;"/>
                                <TextBlock x:Name="CopyCodeText" Text="Copy code"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid x:Name="OfflineRow" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OfflineBox" Tag="Nickname for the new offline account"
                                 KeyDown="Offline_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource Outlined}" Margin="6,0,0,0"
                                Click="AddOffline_Click" AutomationProperties.Name="Add">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE73E;"/>
                                <TextBlock Text="Add"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="AddHint" Style="{StaticResource Subtle}" FontSize="11.5"
                               Margin="0,9,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
