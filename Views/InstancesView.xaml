<UserControl x:Class="CraftDeck.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Instances" Style="{StaticResource H1}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Outlined}" Click="Import_Click" Margin="0,0,8,0" AutomationProperties.Name="Import .mr pack" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE8B5;"/>
                        <TextBlock Text="Import .mr pack"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Accent}" Click="New_Click" AutomationProperties.Name="New instance" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE710;"/>
                        <TextBlock Text="New instance"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <StackPanel x:Name="EmptyHint" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="46"
                           HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource SubtleBrush}"
                           Opacity="0.55"/>
                <TextBlock Text="No instances yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Press “New instance” to create your first modpack."
                           Foreground="{DynamicResource SubtleBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Cards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="252" Margin="0,0,14,14" Cursor="Hand" MouseUp="Card_Open">
                                <Grid.RenderTransform>
                                    <TranslateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)"
                                                                 To="-4" Duration="0:0:0.13"/>
                                                <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="-3" Duration="0:0:0.13"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Border Style="{StaticResource HoverCard}" Padding="0">
                                    <StackPanel>
                                        <Border Height="88" CornerRadius="13,13,0,0" Background="{DynamicResource TileGradBrush}">
                                            <Grid>
                                                <Grid x:Name="Glyph">
                                                    <Grid.RenderTransform>
                                                        <TranslateTransform/>
                                                    </Grid.RenderTransform>
                                                    <Path Data="{StaticResource Spark}" Width="46" Height="46"
                                                          Stretch="Uniform" Opacity="0.5"
                                                          Fill="{DynamicResource TextBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding StarVis}"/>
                                                    <TextBlock Text="{Binding Glyph}" FontSize="40"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding GlyphVis}"/>
                                                    <Image Source="{Binding IconImage}" Width="72" Height="72"
                                                           Visibility="{Binding IconVis}"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                                        Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="7,3">
                                                    <TextBlock Text="{Binding LoaderBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentFgBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="14,10,14,4">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Subtle}" FontSize="10" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Grid Margin="10,8,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource Accent}" Padding="0,7" FontSize="12"
                                                    Tag="{Binding Inst}" Click="Play_Click" Margin="0,0,6,0"
                                                    AutomationProperties.Name="{Binding ActionLabel}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE768;"
                                                               Visibility="{Binding PlayGlyphVis}"/>
                                                    <Border Width="8" Height="8" CornerRadius="1.5" Margin="0,0,6,0"
                                                            VerticalAlignment="Center" Visibility="{Binding StopGlyphVis}"
                                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <TextBlock Text="{Binding ActionLabel}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Width="34" Tag="{Binding Inst}" Click="More_Click"
                                                ToolTip="Open folder, copy, delete" AutomationProperties.Name="More actions" >
                                                <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                            </Button>
                                            <Button Grid.Column="2" Width="34" Tag="{Binding Inst}" Click="AddContent_Click"
                                                ToolTip="Add mods / shaders / packs" AutomationProperties.Name="Add content" >
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Popup x:Name="MorePopup" PlacementTarget="{x:Null}" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="4">
                    <StackPanel MinWidth="170">
                        <Button Style="{StaticResource Ghost}" HorizontalContentAlignment="Left" Click="OpenFolder_Click" AutomationProperties.Name="Open folder" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE838;"/>
                                <TextBlock Text="Open folder"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" HorizontalContentAlignment="Left" Click="OpenMods_Click" AutomationProperties.Name="Open mods folder" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BtnIcon}" Text="&#xEA86;"/>
                                <TextBlock Text="Open mods folder"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" HorizontalContentAlignment="Left" Click="Settings_Click" AutomationProperties.Name="Settings" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE713;"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" HorizontalContentAlignment="Left" Click="Duplicate_Click" AutomationProperties.Name="Duplicate" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE8C8;"/>
                                <TextBlock Text="Duplicate"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Danger}" HorizontalContentAlignment="Left" BorderThickness="0" Click="Delete_Click" AutomationProperties.Name="Delete" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE74D;"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
