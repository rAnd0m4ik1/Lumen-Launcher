<Window x:Class="CraftDeck.Dialogs.NewInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="New instance" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleGradBrush}"
                    BorderBrush="{DynamicResource HairlineDarkBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                            <Path Width="9" Height="9" Stretch="None" Fill="{DynamicResource AccentFgBrush}"
                                  Data="M4.5,0 L5.5,3.5 L9,4.5 L5.5,5.5 L4.5,9 L3.5,5.5 L0,4.5 L3.5,3.5 Z"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="New instance" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionClose}"
                            Width="34" Height="28" Margin="0,0,4,0" Click="Cancel_Click"
                            ToolTip="Close" AutomationProperties.Name="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22">
                <TextBlock Text="Create a new instance" Style="{StaticResource H2}" FontSize="18"/>
                <TextBlock Text="A separate folder with its own version, mods, shaders and configs."
                           Style="{StaticResource Subtle}" Margin="0,3,0,14"/>

                <TextBlock Text="Name" Style="{StaticResource Subtle}"/>
                <TextBox x:Name="NameBox" Margin="0,4,0,12"/>

                <TextBlock Text="Minecraft version" Style="{StaticResource Subtle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <ComboBox x:Name="MCBox" Width="200"/>
                    <CheckBox x:Name="Snapshots" Content="snapshots" Margin="12,0,0,0" VerticalAlignment="Center"
                              Checked="Snapshots_Changed" Unchecked="Snapshots_Changed"/>
                </StackPanel>

                <TextBlock Text="Mod loader" Style="{StaticResource Subtle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <ComboBox x:Name="LoaderBox" Width="130"/>
                    <ComboBox x:Name="LoaderVerBox" Width="180" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="LoaderHint" Style="{StaticResource Subtle}" Margin="0,0,0,8"
                           Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Style="{StaticResource Ghost}" Click="Cancel_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CreateBtn" Content="Create" Style="{StaticResource Accent}" Click="Create_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
