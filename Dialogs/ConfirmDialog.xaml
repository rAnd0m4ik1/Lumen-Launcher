<Window x:Class="CraftDeck.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lumen" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleGradBrush}"
                    BorderBrush="{DynamicResource HairlineDarkBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                            <Path Width="9" Height="9" Stretch="None" Fill="{DynamicResource AccentFgBrush}"
                                  Data="M4.5,0 L5.5,3.5 L9,4.5 L5.5,5.5 L4.5,9 L3.5,5.5 L0,4.5 L3.5,3.5 Z"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText" Text="Delete" FontSize="12" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionClose}"
                            Width="34" Height="28" Margin="0,0,4,0" Click="Cancel_Click"
                            ToolTip="Close" AutomationProperties.Name="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22">
                <TextBlock x:Name="Question" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="Detail" Style="{StaticResource Subtle}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Style="{StaticResource Ghost}" Click="Cancel_Click"
                            Margin="0,0,8,0" IsCancel="True" AutomationProperties.Name="Cancel"/>
                    <Button x:Name="ConfirmBtn" Content="Delete" Style="{StaticResource Danger}"
                            Click="Confirm_Click" Padding="16,7" AutomationProperties.Name="Confirm"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
