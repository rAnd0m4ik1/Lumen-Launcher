<Window x:Class="CraftDeck.Dialogs.InstanceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Instance settings" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleGradBrush}"
                    BorderBrush="{DynamicResource HairlineDarkBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                            <Path Width="9" Height="9" Stretch="None" Fill="{DynamicResource AccentFgBrush}"
                                  Data="M4.5,0 L5.5,3.5 L9,4.5 L5.5,5.5 L4.5,9 L3.5,5.5 L0,4.5 L3.5,3.5 Z"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Instance settings" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionClose}"
                            Width="34" Height="28" Margin="0,0,4,0" Click="Cancel_Click"
                            ToolTip="Close" AutomationProperties.Name="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22">
                <TextBlock Text="Name" Style="{StaticResource Subtle}"/>
                <TextBox x:Name="NameBox" Margin="0,4,0,14"/>

                <TextBlock Text="Icon" Style="{StaticResource Subtle}"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="14" VerticalAlignment="Top"
                            Background="{DynamicResource TileGradBrush}"
                            BorderBrush="{DynamicResource HairlineDarkBrush}" BorderThickness="1">
                        <Grid>
                            <Path x:Name="PreviewStar" Data="{StaticResource Spark}" Width="32" Height="32"
                                  Stretch="Uniform" Opacity="0.5" Fill="{DynamicResource TextBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="PreviewGlyph" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PreviewImage" Width="58" Height="58" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <Button x:Name="PickBtn" Content="Choose image…" Style="{StaticResource Outlined}"
                                HorizontalAlignment="Left" Click="Pick_Click"/>
                        <Button x:Name="RemoveBtn" Content="Remove" Style="{StaticResource Ghost}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Click="Remove_Click"/>
                        <TextBox x:Name="GlyphBox" Width="72" Margin="0,8,0,0" HorizontalAlignment="Left"
                                 MaxLength="4" TextAlignment="Center"
                                 ToolTip="Or type an emoji" AutomationProperties.Name="Icon emoji"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource Ghost}" Click="Cancel_Click" Margin="0,0,8,0"/>
                        <Button Content="Save" Style="{StaticResource Accent}" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
